{
  "kind": "occasion",
  "id": "interview",
  "name": "Interview",
  "criteria": [
    {
      "id": "interview-collar-buttoned",
      "kind": "clothing",
      "clef": "Is the collar buttoned, rather than open at the neck?",
      "suggestion": "The collar reads open; try it buttoned."
    },
    {
      "id": "interview-garment-plain",
      "kind": "clothing",
      "clef": "Is the garment a plain structured shirt, rather than a pattern, a tee, or festive wear?",
      "suggestion": "The garment reads casual; try a plain buttoned shirt."
    },
    {
      "id": "interview-hair-close",
      "kind": "grooming",
      "clef": "Is the hair off the face and sitting close, rather than across the eyes or standing up?",
      "suggestion": "The hair crosses the face; try it tied back or cut short."
    },
    {
      "id": "interview-beard-short",
      "kind": "grooming",
      "clef": "Is facial hair either absent or a short even shape that stays off the collar, not a long or patchy outline?",
      "suggestion": "The beard reads untidy; try a short even shape."
    },
    {
      "id": "lip-quiet",
      "kind": "grooming",
      "clef": "Is the lip either bare or a quiet nude, not a bright colour?",
      "suggestion": "The lip reads bright; try a nude."
    },
    {
      "id": "interview-expression-calm",
      "kind": "expression",
      "clef": "Is the expression calm, with the mouth relaxed, rather than a flat stare or a wide grin?",
      "suggestion": "The expression reads tense; try a closed-mouth smile."
    },
    {
      "id": "interview-light-plain",
      "kind": "lighting",
      "clef": "Is the light plain and even on both eyes, with no coloured cast and no hard shadow?",
      "suggestion": "The face is lit flat; face a plain window. No fix here can relight the photo."
    }
  ],
  "biggest_issue": {
    "question": "Which missed part of this dress code is the biggest issue?",
    "options": [
      {"id": "interview-collar-buttoned", "label": "the collar"},
      {"id": "interview-garment-plain", "label": "the garment"},
      {"id": "interview-hair-close", "label": "the hair"},
