{
  "kind": "occasion",
  "id": "family-function",
  "name": "Family function",
  "criteria": [
    {
      "id": "family-earring-festive",
      "kind": "grooming",
      "clef": "Are gold jhumkas visible, rather than a bare ear or a plain stud?",
      "suggestion": "The ear reads plain; try gold jhumkas."
    },
    {
      "id": "family-lip-colour",
      "kind": "grooming",
      "clef": "Is the lip a clear colour, rather than bare?",
      "suggestion": "The lip reads bare; try a red lip."
    },
    {
      "id": "family-garment-festive",
      "kind": "clothing",
      "clef": "Is the garment a festive top, rather than an office shirt or a plain tee?",
      "suggestion": "The garment reads like an office shirt; try a festive top."
    },
    {
      "id": "family-hair-finished",
      "kind": "grooming",
      "clef": "Does the hair look finished and off the eyes, either tied back or cut short and neat?",
      "suggestion": "The hair is unfinished; try it tied back."
    },
    {
      "id": "family-beard-even",
      "kind": "grooming",
      "clef": "Is facial hair either absent or one neat shape, not a patchy outline?",
      "suggestion": "The beard outline is patchy; try a short even shape."
    },
    {
      "id": "family-expression-present",
      "kind": "expression",
      "clef": "Is the expression present and calm, rather than a flat stare or a wide grin?",
      "suggestion": "The expression reads flat; try a closed-mouth smile."
    },
    {
      "id": "family-light-even",
      "kind": "lighting",
      "clef": "Is the face lit evenly enough that both eyes are visible, without a hard shadow?",
      "suggestion": "The face is lit unevenly; turn toward the light. No fix here can relight the photo."
    }
  ],
  "biggest_issue": {
    "question": "Which missed part of this dress code is the biggest issue?",
    "options": [
      {"id": "family-earring-festive", "label": "the earring"},
      {"id": "family-lip-colour", "label": "the lip"},
      {"id": "family-garment-festive", "label": "the garment"},
      {"id": "family-hair-finished", "label": "the hair"},
      {"id": "family-beard-even", "label": "the facial hair"},
      {"id": "family-expression-present", "label": "the expression"},
      {"id": "family-light-even", "label": "the light"},
      {"id": "none", "label": "none"},
      {"id": "cant-tell", "label": "can't tell"}
    ]
  },
  "fixes": [
    {
      "id": "family-gold-jhumkas",
      "opt_in": true,
      "changes": "Adds gold jhumkas.",
      "youcam": {
        "set": "Jewelry & Watch",
        "task": "2d-vto/earring",
        "method": "POST",
        "path": "/s2s/v2.0/task/2d-vto/earring",
        "path_verified": true,
        "public_name": "AI Earring Virtual Try-On",
        "doc": "https://docs.perfectcorp.com/reference/description/ai_2d_vto_earring.md"
      },
      "analysis": [],
      "criteria": ["family-earring-festive"],
      "vocabulary": [
        {"attribute": "jewellery", "to": "jhumkas"},
        {"attribute": "jewellery_colour", "to": "gold"}
      ],
      "products": ["gold-jhumkas"],
      "note": "This is the fix the family-function story keeps. A front selfie is supported; the page says a side view renders better."
    },
    {
      "id": "family-red-lip",
      "opt_in": true,
      "changes": "Paints the lip red.",
      "youcam": {
