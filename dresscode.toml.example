# Dresscode settings. Copy to dresscode.toml.
# A key is a reference. This file holds no key value.
# Names are the variables in docs/keys.md.
# The list order is the fallback order. Environment, then the keyring
# where that file records one. Nothing falls back past the list.

[budgets.youcam]
# Lifetime credit ceiling. The credits do not expire.
# judging_units is spent only by the judging owner.
units = 1040
judging_units = 400

[budgets.workers_ai]
# Dollar ceiling for one UTC day.
# No dollar ceiling was recorded. One dollar is the guard.
# Change it here when Workers Paid is on.
dollars_per_day = 1

[lease.judge]
# Caps for one judge session. A cached sample does not count.
# Five fresh selfies is one per occasion.
# Ten renders is a render and a runner-up for each.
fresh_selfies = 5
renders = 10

[flags]
# True is the restriction. False is the open position.
# A running server flips the stored value without a restart.
fresh_uploads_off = false
renders_off = false
samples_only = false

[paths]
# The two data directories the server reads. The section may be omitted -
# `dresscode budget` and `dresscode flag` need no directories - but
# `dresscode serve` refuses to boot without both. The values here are
# this repository's own data, laid out the way the loaders require.
occasions = "testdata/occasions"
# The samples directory carries the recordings' layout: a story reads a
# recorded provider result from <samples>/../youcam/results beside it,
# and the catalog pictures a shop list shows come from
# <samples>/products. Move one without the other and the samples mount
# refuses, naming both roots it tried.
samples = "testdata/samples"

[judge]
# The lines that turn Clef's read into flags. A criterion flags when its
# yes-probability sits under its line. per_criterion names a line per
# criterion id; absent, every criterion reads met.
# Every line here is the evaluation's (docs/evaluation.md): the widest
# plateau with the most agreement on that criterion's measured curve.
# 269 of 273 judged cells agree at these lines; the four that remain
# are a wording problem, not a threshold problem.
met = 0.35265

[judge.per_criterion]
date-beard-even = 0.19435
family-beard-even = 0.1682
funeral-beard-close = 0.26845
interview-beard-short = 0.18815
interview-collar-buttoned = 0.1126
interview-expression-calm = 0.2022

[check]
# The lines that turn the render check's probabilities into facts, and
# the model the check runs on. The lines are the evaluation's: every
# known bad render discarded, zero honest renders lost, at least 0.44
# of margin per gate on this model. clef wins the vocabulary (19 of 22
# true attribute answers against clef-flash's 18), at about 132 neurons
# a look instead of 57.
change_made = 0.4978
same_person = 0.4799
criterion_met = 0.4986
model = "clef"

[[secrets.youcam_api_key]]
source = "env"
var = "YOUCAM_API_KEY"

[[secrets.youcam_api_key]]
source = "keyring"
var = "YOUCAM_API_KEY"

[[secrets.youcam_api_secret]]
source = "env"
var = "YOUCAM_API_SECRET"

[[secrets.youcam_api_secret]]
source = "keyring"
var = "YOUCAM_API_SECRET"

[[secrets.workers_ai_api_token]]
source = "env"
var = "WORKERS_AI_API_TOKEN"

[[secrets.workers_ai_api_token]]
source = "keyring"
var = "WORKERS_AI_API_TOKEN"

[secrets.cloudflare_account_id]
source = "env"
var = "CLOUDFLARE_ACCOUNT_ID"

[secrets.resend_api_key]
source = "env"
var = "RESEND_API_KEY"

[secrets.resend_from]
source = "env"
var = "RESEND_FROM"

[secrets.openrouter_api_key]
source = "env"
var = "OPENROUTER_API_KEY"

[secrets.openrouter_base_url]
source = "env"
var = "OPENROUTER_BASE_URL"

[secrets.lambo_url]
source = "env"
var = "LAMBO_URL"

[secrets.lambo_dresscode_token]
source = "env"
var = "LAMBO_DRESSCODE_TOKEN"
